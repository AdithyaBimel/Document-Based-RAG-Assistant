# Copy this file to .env and fill in your values
# .env is gitignored — never commit your real keys

# Option A: Groq API (Free) — Recommended for beginners
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option B: OpenAI API (Paid)
OPENAI_API_KEY=your_openai_api_key_here

# Mode: "local" uses Mistral 7B on your RTX 4050
#        "groq"  uses Groq free API
#        "openai" uses OpenAI API
LLM_MODE=groq

LOCAL_MODEL=mistralai/Mistral-7B-Instruct-v0.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTORSTORE_PATH=./vectorstore/faiss_index
